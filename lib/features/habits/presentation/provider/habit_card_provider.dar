import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../mappers/habit_card_view_model_mapper.dart';
import 'filtered_habits_provider.dart';

final habitCardProvider = Provider<List<HabitCardViewModel>>((ref) {
  final habitsAsync = ref.watch(filteredHabitsProvider);

  final mapper = const HabitCardViewModelMapper();

  return habitsAsync.maybeWhen(
    data: (habits) => habits.map(mapper.map).toList(),
    orElse: () => const [],
  );
});